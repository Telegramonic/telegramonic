{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@assets": ["../common/src/assets"],
      "@assets/*": ["../common/src/assets/*"],
      "@components": ["../common/src/components"],
      "@components/*": ["../common/src/components/*"],
      "@data": ["src/data"],
      "@data/*": ["src/data/*"],
      "@providers": ["src/providers"],
      "@providers/*": ["src/providers/*"],
      "@localization": ["../common/src/localization"],
      "@localization/*": ["../common/src/localization/*"],
      "@routes": ["src/routes"],
      "@routes/*": ["src/routes/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@uiStore": ["src/store/ui"],
      "@uiStore/*": ["src/store/ui/*"],
      "@appStore": ["src/store/app"],
      "@appStore/*": ["src/store/app/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@testUtils": ["../common/src/testUtils"],
      "@testUtils/*": ["../common/src/testUtils/*"]
    }
  }
}
