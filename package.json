{
  "name": "telegramonic-monorepo",
  "private": true,
  "workspaces": [
    "web",
    "server",
    "desktop",
    "common"
  ],
  "scripts": {
    "web:dev": "yarn workspace telegramonic-web start",
    "web:Dev": "yarn web:dev",
    "web:build": "yarn workspace telegramonic-web build",
    "web:test": "yarn workspace telegramonic-web test",
    "common:test": "yarn workspace telegramonic-web test ../common",
    "web:lint": "yarn workspace telegramonic-web lint",
    "server:start": "yarn workspace telegramonic-server start",
    "server:build": "yarn workspace telegramonic-server build",
    "server:test": "yarn workspace telegramonic-server test",
    "desktop:start": "yarn workspace telegramonic-desktop start",
    "desktop:build": "yarn workspace telegramonic-desktop build",
    "prettier:staged": "yarn workspace telegramonic-web run prettier:staged",
    "lint:staged": "yarn workspace telegramonic-web run lint:staged",
    "run-staged-tests": "./scripts/run-staged-tests.sh",
    "run-pushed-files-tests": "./scripts/run-staged-tests.sh --pushed",
    "prepare": "husky"
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "husky": "^9.0.11"
  }
}
